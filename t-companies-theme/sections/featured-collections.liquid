<section class="section" aria-labelledby="collections-title-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading">
      <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="collections-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <a class="text-link" href="{{ routes.collections_url }}">All collections <span class="diagonal-arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a>
    </div>
    <div class="collection-grid">
      {% for block in section.blocks %}
        {% assign selected_collection = block.settings.collection %}
        {% assign tile_title = block.settings.title | default: selected_collection.title %}
        {% assign tile_image = block.settings.image | default: selected_collection.featured_image %}
        {% assign tile_url = selected_collection.url | default: routes.all_products_collection_url %}
        <a class="collection-tile collection-tile--{{ forloop.index }}" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <div class="collection-tile__media">
            {% if tile_image != blank %}
              {{ tile_image | image_url: width: 900 | image_tag: widths: '300, 500, 700, 900', sizes: '(min-width: 990px) 30vw, 46vw', loading: 'lazy' }}
            {% else %}
              {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
              {% assign placeholder_name = 'collection-' | append: placeholder_index %}
              {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            <span class="collection-tile__number" aria-hidden="true">0{{ forloop.index }}</span>
          </div>
          <div class="collection-tile__content"><h3>{{ tile_title | default: 'Choose a collection' | escape }}</h3><span class="diagonal-arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Featured collections",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your everyday exceptional"},
    {"type":"text","id":"heading","label":"Heading","default":"A world of possibility."}
  ],
  "blocks":[{"type":"collection","name":"Collection","settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"title","label":"Custom title"},
    {"type":"image_picker","id":"image","label":"Custom image"}
  ]}],
  "presets":[{"name":"Featured collections","blocks":[
    {"type":"collection","settings":{"title":"Electronics"}},
    {"type":"collection","settings":{"title":"Fashion"}},
    {"type":"collection","settings":{"title":"Home & Living"}},
    {"type":"collection","settings":{"title":"Gadgets & Tools"}},
    {"type":"collection","settings":{"title":"Accessories"}},
    {"type":"collection","settings":{"title":"Outdoor & Lifestyle"}}
  ]}]
}
{% endschema %}
