<section class="section page-width">
  <div class="catalog-heading"><p class="eyebrow">FIND SOMETHING EXCEPTIONAL</p><h1>Search the collection</h1><form action="{{ routes.search_url }}" method="get" class="page-search" role="search"><label class="visually-hidden" for="PageSearch">Search products</label><input type="search" id="PageSearch" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" required><input type="hidden" name="type" value="product"><button class="button" type="submit">Search</button></form></div>
  {% if search.performed %}<p role="status">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="catalog-layout"><aside class="catalog-sidebar" aria-label="Search filters">{% render 'filters', results: search %}</aside><div class="catalog-results">{% render 'active-filters', results: search %}{% paginate search.results by 24 %}<div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article class="content-card"><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2><p>{{ result.content | strip_html | truncate: 160 }}</p></article>{% endif %}{% else %}<div class="empty-state"><h2>No matches this time</h2><p>Try a different name, broader search, or fewer filters.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore all products</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></div>{% endif %}
</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
