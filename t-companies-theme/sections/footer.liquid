<footer class="site-footer">
  <div class="page-width">
    <div class="newsletter-row">
      <div><p class="eyebrow">THE T COMPANIES EDIT</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div>
      {% assign newsletter_id = 'Newsletter-' | append: section.id %}
      {% form 'customer', id: newsletter_id, class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="NewsletterEmail-{{ section.id }}">Email address</label>
        <div class="newsletter-field"><input type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" value="{{ form.email }}" required autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="you@example.com"{% if form.errors %} aria-describedby="NewsletterError-{{ section.id }}" aria-invalid="true"{% endif %}><button type="submit" aria-label="Subscribe to the newsletter">{% render 'icon', name: 'arrow' %}</button></div>
        {% if form.posted_successfully? %}<p role="status">Thank you for subscribing.</p>{% endif %}
        {% if form.errors %}<div id="NewsletterError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <small>By subscribing, you agree to receive marketing emails. Unsubscribe at any time.{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.{% endif %}</small>
      {% endform %}
    </div>
    <div class="footer-grid">
      <div class="footer-brand"><a class="brand" href="{{ routes.root_url }}"><span class="brand__monogram" aria-hidden="true">T<span>.</span></span><span class="brand__wordmark">{{ settings.brand_name | escape }}</span></a><p>{{ section.settings.brand_copy | escape }}</p></div>
      <div><h3>Explore</h3><ul>{% if section.settings.shop_menu.links.size > 0 %}{% for link in section.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% else %}<li><a href="{{ routes.all_products_collection_url }}">Shop all products</a></li><li><a href="{{ routes.collections_url }}">Collections</a></li><li><a href="{{ routes.search_url }}">Search</a></li>{% endif %}</ul></div>
      <div><h3>Customer care</h3><ul>{% for link in section.settings.help_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul></div>
      {% if localization.available_countries.size > 1 %}<div><h3>Your region</h3>{% form 'localization', id: 'FooterLocalization' %}<label for="FooterCountry">Country / currency</label><select id="FooterCountry" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }})</option>{% endfor %}</select><button class="button button--small" type="submit">Update region</button>{% endform %}</div>{% endif %}
    </div>
    <div class="footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | escape }}. All rights reserved.</small><div class="payment-icons" aria-label="Accepted payment methods">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}</div></div>
  </div>
</footer>
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"heading","label":"Newsletter heading","default":"Good things. In your inbox."},{"type":"text","id":"description","label":"Newsletter description","default":"New discoveries, considered collections, and the latest from T Companies."},{"type":"textarea","id":"brand_copy","label":"Brand introduction","default":"Technology, style, and everyday essentials. A world of well-chosen things, all in one place."},{"type":"link_list","id":"shop_menu","label":"Shopping menu"},{"type":"link_list","id":"help_menu","label":"Customer service menu"}]}
{% endschema %}
