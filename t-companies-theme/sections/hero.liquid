<section class="hero" aria-labelledby="hero-title-{{ section.id }}">
  <div class="page-width hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow hero__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="hero-title-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% if section.settings.text != blank %}<div class="hero__text">{{ section.settings.text }}</div>{% endif %}
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span class="diagonal-arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="hero__secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
      </div>
      <div class="hero__signature"><span class="hero__signature-line"></span><span>Thoughtfully selected. Everyday exceptional.</span></div>
    </div>
    <div class="hero__visual{% if section.settings.image != blank %} hero__visual--image{% endif %}">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '480, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'hero__image' }}
      {% else %}
        <div class="hero__orb" aria-hidden="true"></div>
        <div class="hero__art" aria-hidden="true"><span class="hero__art-word">T</span><span class="hero__art-caption">THE EVERYDAY.<br>ELEVATED.</span></div>
        <div class="hero__visual-caption"><span>THE T COMPANIES EDIT</span><span>01 — 06</span></div>
      {% endif %}
    </div>
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} .hero{background:#111214;color:#fff;overflow:hidden;position:relative}
  #shopify-section-{{ section.id }} .hero__inner{display:grid;grid-template-columns:1.08fr 1fr;min-height:640px;align-items:center;gap:3rem}
  #shopify-section-{{ section.id }} .hero__copy{padding:5rem 0;position:relative;z-index:1}
  #shopify-section-{{ section.id }} .hero__eyebrow{display:flex;align-items:center;gap:.7rem;color:#d9c4a0}
  #shopify-section-{{ section.id }} .hero__eyebrow>span{width:7px;height:7px;border-radius:50%;background:#d9c4a0}
  #shopify-section-{{ section.id }} .hero h1{color:#fff;font-size:clamp(3rem,6.3vw,6.3rem);font-weight:500;line-height:1.02;letter-spacing:-.065em;max-width:750px;margin:1.6rem 0}
  #shopify-section-{{ section.id }} .hero__text{max-width:420px;color:#b2b4bb;font-size:1.05rem;line-height:1.8}
  #shopify-section-{{ section.id }} .hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.8rem;margin-top:2rem}
  #shopify-section-{{ section.id }} .hero__actions .button{gap:2rem}
  #shopify-section-{{ section.id }} .hero__secondary{color:#fff;text-decoration:none;font-size:.9rem;display:flex;gap:.8rem;align-items:center}
  #shopify-section-{{ section.id }} .hero__secondary:hover{text-decoration:underline;text-underline-offset:5px}
  #shopify-section-{{ section.id }} .hero__signature{display:flex;align-items:center;gap:1rem;font-size:.7rem;letter-spacing:.035em;color:#999da7;margin-top:3.5rem}
  #shopify-section-{{ section.id }} .hero__signature-line{height:1px;width:38px;background:#646772}
  #shopify-section-{{ section.id }} .hero__visual{height:540px;position:relative;align-self:end;isolation:isolate;background:radial-gradient(ellipse at 55% 60%,#363943 0,transparent 60%)}
  #shopify-section-{{ section.id }} .hero__orb{position:absolute;inset:2rem -4rem 1rem 1rem;border:1px solid #444752;border-radius:50%;transform:rotate(-25deg);box-shadow:inset 0 0 80px #252831}
  #shopify-section-{{ section.id }} .hero__art{position:absolute;left:14%;right:4%;top:10%;bottom:12%;border:1px solid #747885;border-radius:12px;background:linear-gradient(135deg,#424650,#1d2027 55%,#14161b);box-shadow:20px 30px 55px #0008;transform:rotate(-9deg);display:flex;align-items:center;justify-content:center;overflow:hidden}
  #shopify-section-{{ section.id }} .hero__art:before{content:'';position:absolute;width:430px;height:430px;background:radial-gradient(circle,#b89a6030,transparent 65%);top:-190px;right:-100px}
  #shopify-section-{{ section.id }} .hero__art-word{font-family:Georgia,serif;font-size:19rem;line-height:1;color:#d2c1a0;text-shadow:2px 3px 0 #5a5247,-1px -1px 0 #f6e8cb}
  #shopify-section-{{ section.id }} .hero__art-caption{position:absolute;left:1.7rem;bottom:1.6rem;font-size:.55rem;line-height:1.8;letter-spacing:.2em;color:#c4c7ce}
  #shopify-section-{{ section.id }} .hero__visual-caption{position:absolute;bottom:1.6rem;left:10%;right:0;display:flex;justify-content:space-between;font-size:.6rem;letter-spacing:.16em;color:#a9adb7}
  #shopify-section-{{ section.id }} .hero__visual--image{align-self:stretch;height:auto;min-height:540px}
  #shopify-section-{{ section.id }} .hero__image{width:100%;height:100%;object-fit:cover}
  @media(max-width:989px){#shopify-section-{{ section.id }} .hero__inner{min-height:0;gap:0;grid-template-columns:1fr 1fr}#shopify-section-{{ section.id }} .hero__visual{height:420px}#shopify-section-{{ section.id }} .hero__art-word{font-size:13rem}#shopify-section-{{ section.id }} .hero__copy{padding:4rem 0}#shopify-section-{{ section.id }} .hero__signature{margin-top:2rem}#shopify-section-{{ section.id }} .hero__visual--image{min-height:420px}}
  @media(max-width:699px){#shopify-section-{{ section.id }} .hero__inner{grid-template-columns:1fr}#shopify-section-{{ section.id }} .hero__copy{padding:3.5rem 0 1.5rem}#shopify-section-{{ section.id }} .hero h1{font-size:clamp(3.3rem,13vw,5rem)}#shopify-section-{{ section.id }} .hero__visual{height:340px;max-width:450px;width:100%;justify-self:center}#shopify-section-{{ section.id }} .hero__orb{inset:1rem 0}#shopify-section-{{ section.id }} .hero__art{left:16%;right:12%;top:7%;bottom:17%}#shopify-section-{{ section.id }} .hero__art-word{font-size:12rem}#shopify-section-{{ section.id }} .hero__visual--image{min-height:320px;margin-top:1rem}#shopify-section-{{ section.id }} .hero__visual-caption{left:5%;right:5%}}
</style>
{% schema %}
{
  "name": "Brand hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A considered collection"},
    {"type":"textarea","id":"heading","label":"Heading","default":"Exceptional essentials.\nElevated living."},
    {"type":"richtext","id":"text","label":"Description","default":"<p>Discover technology, style, and everyday upgrades. Carefully selected for the way you live.</p>"},
    {"type":"text","id":"button_label","label":"Primary button label","default":"Explore the collection"},
    {"type":"url","id":"button_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Find your next favorite"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"image_picker","id":"image","label":"Hero image","info":"Optional. Upload a landscape product or lifestyle photograph."}
  ],
  "presets": [{"name":"Brand hero"}]
}
{% endschema %}
