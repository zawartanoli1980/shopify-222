{% assign review_count = 0 %}
{% for block in section.blocks %}{% if block.settings.quote != blank and block.settings.author != blank %}{% assign review_count = review_count | plus: 1 %}{% endif %}{% endfor %}
{% if review_count > 0 or request.design_mode %}
<section class="section section--soft" aria-labelledby="testimonials-title-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="testimonials-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div></div>
    <div class="testimonial-grid">
      {% for block in section.blocks %}
        {% if block.settings.quote != blank and block.settings.author != blank %}
          <figure class="testimonial-card" {{ block.shopify_attributes }}><span class="testimonial-card__quote" aria-hidden="true">“</span><blockquote>{{ block.settings.quote | escape | newline_to_br }}</blockquote><figcaption>{{ block.settings.author | escape }}{% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}</figcaption></figure>
        {% elsif request.design_mode %}
          <div class="testimonial-card" {{ block.shopify_attributes }}><p class="editor-note">Add a verified customer review and reviewer name here. Empty reviews are hidden from the live storefront. Obtain permission before publishing.</p></div>
        {% endif %}
      {% endfor %}
      {% if section.blocks.size == 0 and request.design_mode %}<div class="testimonial-card"><p class="editor-note">Add a review block with real customer feedback. This section remains hidden from the live storefront until you add reviews.</p></div>{% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name":"Customer stories",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"In your words"},
    {"type":"text","id":"heading","label":"Heading","default":"Customer stories."}
  ],
  "blocks":[{"type":"review","name":"Customer review","settings":[
    {"type":"textarea","id":"quote","label":"Review","info":"Use genuine customer feedback with permission."},
    {"type":"text","id":"author","label":"Reviewer name"},
    {"type":"text","id":"detail","label":"Optional detail","info":"Only add a verified purchase claim if you have verified it."}
  ]}],
  "presets":[{"name":"Customer stories","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]
}
{% endschema %}
