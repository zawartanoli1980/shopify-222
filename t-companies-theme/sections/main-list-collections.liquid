<section class="section page-width"><div class="catalog-heading"><p class="eyebrow">CURATED FOR EVERYDAY</p><h1>Explore our collections</h1><p>A world of well-chosen things, organized around you.</p></div>{% paginate collections by 24 %}<div class="collection-grid">{% for collection in collections %}<a class="collection-tile" href="{{ collection.url }}"><div class="collection-tile__media">{% assign image = collection.featured_image %}{% if image %}{{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 540, 800', sizes: '(min-width: 750px) 33vw, 50vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="collection-tile__content"><h2>{{ collection.title | escape }}</h2><span aria-hidden="true">↗</span></div></a>{% else %}<div class="empty-state"><h2>Your collections begin here</h2><p>Collections will appear once added in Shopify.</p><a class="button" href="{{ routes.all_products_collection_url }}">Browse products</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Collections list","settings":[]}{% endschema %}
