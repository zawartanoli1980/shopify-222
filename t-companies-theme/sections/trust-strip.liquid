<section class="trust-section" aria-label="Shopping information">
  <div class="page-width trust-grid">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <span class="trust-item__icon" aria-hidden="true">{% case block.settings.icon %}{% when 'lock' %}<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5.5" y="12" width="17" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M9 12V8a5 5 0 0 1 10 0v4M14 17v3" stroke="currentColor" stroke-width="1.4"/></svg>{% when 'detail' %}<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="m14 3 10 5v12l-10 5-10-5V8l10-5Zm0 10v12M4 8l10 5 10-5M9 5.5l10 5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>{% else %}<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M5 15v-2a9 9 0 0 1 18 0v2M23 19v1a4 4 0 0 1-4 4h-3" stroke="currentColor" stroke-width="1.4"/><rect x="3" y="13" width="5" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/><rect x="20" y="13" width="5" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/></svg>{% endcase %}</span>
        <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Shopping information",
  "max_blocks":4,
  "settings":[],
  "blocks":[{"type":"benefit","name":"Shopping benefit","settings":[
    {"type":"select","id":"icon","label":"Icon","options":[{"value":"lock","label":"Secure checkout"},{"value":"detail","label":"Product details"},{"value":"support","label":"Support"}],"default":"lock"},
    {"type":"text","id":"heading","label":"Heading","default":"Secure checkout"},
    {"type":"text","id":"text","label":"Description","default":"Payments processed by Shopify."}
  ]}],
  "presets":[{"name":"Shopping information","blocks":[
    {"type":"benefit","settings":{"icon":"lock","heading":"Secure checkout","text":"Payments processed by Shopify."}},
    {"type":"benefit","settings":{"icon":"detail","heading":"Clear product details","text":"Make an informed choice."}},
    {"type":"benefit","settings":{"icon":"support","heading":"Here to help","text":"Contact us with your questions."}}
  ]}]
}
{% endschema %}
