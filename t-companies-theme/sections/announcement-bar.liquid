{% if section.settings.text != blank %}
  <div class="announcement-bar">
    <div class="page-width announcement-bar__inner">
      <span>{{ section.settings.text | escape }}</span>
      {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span class="diagonal-arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a>{% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{"name":"Announcement bar","settings":[{"type":"text","id":"text","label":"Announcement","default":"Considered essentials. Extraordinary everyday."},{"type":"text","id":"link_label","label":"Link label","default":"Explore the collection"},{"type":"url","id":"link","label":"Link"}]}
{% endschema %}
