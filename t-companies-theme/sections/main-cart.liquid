<section class="section page-width cart-page"><p class="eyebrow">YOUR EVERYDAY EDIT</p><h1>Your bag <span class="muted">({{ cart.item_count }})</span></h1>{% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post" id="CartForm"><div class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-item">
    <a class="cart-item__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: widths: '150, 300', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a>
    <div><p class="eyebrow">{{ item.vendor | escape }}</p><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p class="cart-property">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<label for="Quantity-{{ item.index | plus: 1 }}">Quantity</label><input id="Quantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %}><a class="cart-remove" href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></a></div>
    <div class="cart-item__price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong>{% for discount in item.line_level_discount_allocations %}<small>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</small>{% endfor %}{% if item.unit_price_measurement %}<small>{{ item.unit_price | money }} / {% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }}{% endif %}{{ item.unit_price_measurement.reference_unit }}</small>{% endif %}</div>
  </article>{% endfor %}<button type="submit" name="update" class="button button--secondary">Update bag</button></div><div class="cart-summary"><h2>Order summary</h2>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<div class="cart-subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money_with_currency }}</strong></div><p class="muted">{% if cart.taxes_included %}Taxes included. Shipping calculated at checkout.{% else %}Taxes and shipping calculated at checkout.{% endif %}</p><label for="CartNote">Order note (optional)</label><textarea id="CartNote" name="note" rows="3">{{ cart.note | escape }}</textarea><button class="button button--full" type="submit" name="checkout">Continue to checkout {% render 'icon', name: 'arrow' %}</button><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div></div></form>
  {% else %}<div class="empty-state">{% render 'icon', name: 'bag' %}<h2>Your next discovery is waiting.</h2><p>Your bag is empty. Explore the collection to find something you love.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>{% endif %}
</section>
{% schema %}{"name":"Shopping bag","settings":[]}{% endschema %}
