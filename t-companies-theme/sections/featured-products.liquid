{% assign featured_collection = section.settings.collection %}
<section class="section section--soft" aria-labelledby="featured-title-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading">
      <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="featured-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="carousel-actions">
        <a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">View all <span class="diagonal-arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a>
        <button class="icon-button" type="button" aria-label="Previous products" data-scroll-target="product-carousel-{{ section.id }}" data-scroll-direction="-1">←</button>
        <button class="icon-button" type="button" aria-label="Next products" data-scroll-target="product-carousel-{{ section.id }}" data-scroll-direction="1">→</button>
      </div>
    </div>
    {% if featured_collection.products.size > 0 %}
      <div id="product-carousel-{{ section.id }}" class="product-carousel" role="region" aria-label="{{ section.settings.heading | escape }}" tabindex="0">
        {% for product in featured_collection.products limit: section.settings.limit %}
          {% render 'product-card', product: product, index: forloop.index %}
        {% endfor %}
      </div>
    {% else %}
      <div class="featured-empty"><div class="featured-empty__art" aria-hidden="true">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div><h3>Your next favorite awaits.</h3><p>Explore the collection and discover what speaks to you.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Browse products <span aria-hidden="true">→</span></a>{% if request.design_mode %}<p class="editor-note">Select a populated collection in this section’s settings to display your products.</p>{% endif %}</div></div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Featured products",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The considered edit"},
    {"type":"text","id":"heading","label":"Heading","default":"Standout selections."},
    {"type":"collection","id":"collection","label":"Collection","info":"Choose your Best Sellers or Featured collection."},
    {"type":"range","id":"limit","label":"Maximum products","min":4,"max":12,"step":1,"default":8}
  ],
  "presets":[{"name":"Featured products"}]
}
{% endschema %}
