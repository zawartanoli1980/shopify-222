<article class="section page-width page-content"><p class="eyebrow">{{ blog.title | escape }}</p><h1>{{ article.title | escape }}</h1><p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: widths: '600, 1000, 1400', loading: 'eager', class: 'article-hero' }}{% endif %}<div class="rte">{{ article.content }}</div><a class="text-link" href="{{ blog.url }}">← Back to {{ blog.title | escape }}</a></article>{% schema %}{"name":"Article","settings":[]}{% endschema %}
