<section class="section page-width page-content"><p class="eyebrow">HERE TO HELP</p><h1>{{ page.title | default: 'Contact us' | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact', id: 'ContactForm', class: 'contact-form' %}{% if form.posted_successfully? %}<div class="form-success" role="status">Thank you. Your message has been sent.</div>{% endif %}{% if form.errors %}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required><label for="ContactEmail">Email address</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" required><label for="ContactOrder">Order number (optional)</label><input id="ContactOrder" name="contact[Order number]" type="text"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea><button class="button" type="submit">Send message</button>{% endform %}</section>
{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
